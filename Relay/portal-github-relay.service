[Unit]
Description=Portal GitHub relay
After=network-online.target
Wants=network-online.target

[Service]
User=gitinuum-relay
StateDirectory=gitinuum-relay
StateDirectoryMode=0700
UMask=0077
Environment=DATABASE_PATH=/var/lib/gitinuum-relay/gitinuum.sqlite3
EnvironmentFile=/etc/gitinuum-relay.env
ExecStart=/usr/local/bin/portal-github-relay
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
Alias=gitinuum-relay.service
